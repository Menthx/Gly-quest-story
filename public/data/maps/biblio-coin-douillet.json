      "setFlags": ["bocal-pris"],
      "lines": [
        {
          "text": "Un bocal vide."
        },
        {
          "character": "joueur",
          "text": "« Ça me sera utile pour transporter la terre. »"
        }
      ]
    },
    "glycine": {
      "setFlags": ["glycine-prise"],
      "lines": [
        {
          "text": "Je prends une fiole d'essence de glycine concentrée."
        }
      ]
    }

{
  "$schema": "../../../schemas/map.schema.json",
  "id": "jardin-serre",
  "name": "Jardin : la serre",
  "background": "assets/backgrounds/jardin-serre.jpg",
  "setFlags": ["serre-vue"],
  "regions": [
    {
      "id": "jardiniere",
      "label": "La jardinière",
      "shape": {
        "type": "rect",
        "x": 67,
        "y": 51.5,
        "width": 23.1,
        "height": 16.3
      },
      "action": {
        "type": "dialogue",
        "dialogue": "jardiniere"
      }
    },
    {
      "id": "lavande",
      "label": "Lavande somnolente",
      "if": ["mission-ingredients"],
      "ifNot": ["lavande-prise"],
      "shape": {
        "type": "rect",
        "x": 67,
        "y": 51.5,
        "width": 23.1,
        "height": 16.3
      },
      "action": {
        "type": "dialogue",
        "dialogue": "lavande"
      }
    },
    {
      "id": "vers-cours",
      "label": "Aller dans la cour du jardin",
      "shape": {
        "type": "rect",
        "x": 41,
        "y": 10,
        "width": 22,
        "height": 42
      },
      "action": {
        "type": "goto",
        "map": "jardin-cours"

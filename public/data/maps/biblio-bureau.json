{
  "$schema": "../../../schemas/map.schema.json",
  "id": "biblio-bureau",
  "name": "Bibliothèque : le bureau",
  "background": "assets/backgrounds/biblio-bureau.jpg",
  "setFlags": ["bureau-vu"],
  "triggers": [
    {
      "dialogue": "arrivee"
    }
  ],
  "regions": [
    {
      "id": "naevys",
      "label": "Naevys",
      "ifNot": ["visite-terminee"],
      "shape": {
        "type": "rect",
        "x": 54,
        "y": 47,
        "width": 9.5,
        "height": 14
      },
      "action": {
        "type": "dialogue",
        "dialogue": "naevys"
      }
    },
    {
      "id": "naevys-ingredients",
      "label": "Naevys",
      "if": ["mission-ingredients"],
      "ifNot": ["ingredients-apportes"],
      "shape": {
        "type": "rect",
        "x": 54,
        "y": 47,
        "width": 9.5,
        "height": 14
      },
      "action": {
        "type": "dialogue",
        "dialogue": "naevys-ingredients"
      }
    },
    {
      "id": "sol-arcanique",
      "label": "Le sol arcanique",
      "if": ["ingredients-apportes"],
      "ifNot": ["ingredients-deposes"],
      "shape": {
        "type": "polygon",
        "points": [
          [48, 52.5],
          [56, 51],
          [68, 51.5],
          [74, 53.5],
          [72, 56],
          [50, 56]
        ]
      },
      "action": {
        "type": "dialogue",
        "dialogue": "sol-arcanique"
      }
    },
    {
      "id": "amethyste",
      "label": "Cristaux d'améthyste",
      "if": ["mission-ingredients"],
      "ifNot": ["amethyste-prise"],
      "shape": {
        "type": "rect",
        "x": 37,
        "y": 33.7,
        "width": 6,
        "height": 13.7
      },
      "action": {
        "type": "dialogue",
        "dialogue": "amethyste"
      }
    },
    {
      "id": "retour",
      "label": "Retour dans la bibliothèque",
      "shape": {
        "type": "rect",
        "x": 30,
        "y": 88,
        "width": 40,
        "height": 12
      },
      "action": {
        "type": "goto",
        "map": "bibliotheque"
      },
      "arrow": "down"
    }
  ],
  "dialogues": {
    "arrivee": {
      "lines": [
        {
          "text": "« Au centre se trouve le bureau de Dame Naevys. Les étagères sont remplies d'ouvrages et d'articles de magie divers et variés. Au fond se trouve un sol arcanique pour pratiquer la magie. Il y a également des reliques entreposées par-ci par-là. »"
        }
      ]
    },
    "naevys": {
      "lines": [
        {
          "character": "naevys",
          "text": "« Tu as besoin de quelque chose, mon enfant ? »",
          "choices": [
            {
              "text": "« À quoi sert cette bibliothèque ? »",
              "next": "naevys-bibliotheque"
            },
            {
              "text": "« Y a-t-il un moyen de neutraliser totalement les énergies ? »",
              "next": "naevys-energies"
            },
            {
              "text": "« Je retourne visiter. »",
              "next": "naevys-au-revoir"
            },
            {
              "text": "« J'ai fini de faire le tour, qu'est-ce que je peux faire maintenant ? »",
              "next": "naevys-fin-visite",
              "if": [
                "foyer-vu",
                "bureau-vu",
                "coin-douillet-vu",
                "serre-vue",
                "cours-vu",
                "pergola-vue"
              ]
            }
          ]
        }
      ]
    },
    "naevys-bibliotheque": {
      "next": "naevys",
      "lines": [
        {
          "character": "naevys",
          "text": "« C'est le point central des recherches magiques et des archives de Glyglyland. En cette période, je consacre tout mon temps aux recherches sur les énergies et aux préparatifs du rituel. »"
        },
        {
          "character": "naevys",
          "text": "« Le reste de l'année, je mène différentes missions en parallèle : tenir les archives à jour, faire des cultures de plantes magiques, et parfois j'apporte mon aide à qui veut bien passer la porte de cet humble endroit. »"
        }
      ]
    },
    "naevys-energies": {
      "next": "naevys",
      "lines": [
        {
          "character": "naevys",
          "text": "« Malheureusement, on ne sait pas si c'est possible, c'est pour ça que nous devons mettre notre effort sur les recherches lorsque l'Énergie est présente. »"
        },
        {
          "character": "naevys",
          "text": "« J'ai tout de même une théorie : nous avons constaté que certaines actions avec le flux d'Énergie permettent d'en réduire l'intensité. Je t'en parlerai un peu plus tard, mon enfant. »"
        }
      ]
    },
    "naevys-au-revoir": {
      "lines": [
        {
          "character": "naevys",
          "text": "« N'hésite pas si tu as des questions. Reviens me voir quand tu auras fait le tour du propriétaire ! »"
        }
      ]
    },
    "naevys-fin-visite": {
      "lines": [
        {
          "character": "naevys",
          "text": "« Super ! Alors, ton premier ressenti sur les lieux ? »",
          "choices": [
            {
              "text": "« Rien d'anormal, il me semble ? »",
              "setFlags": ["visite-terminee"],
              "next": "naevys-fin-journee"
            },
            {
              "text": "« Est-ce qu'il est possible de ressentir l'énergie en ce moment même ? »",
              "setFlags": ["visite-terminee"],
              "next": "naevys-fin-journee"
            }
          ]
        }
      ]
    },
    "naevys-fin-journee": {
      "lines": [
        {
          "character": "naevys",
          "text": "« Si tu t'inquiètes de l'Énergie, rassure-toi : il n'est pas simple de la ressentir aussi facilement, même pour moi. Il n'y a pour l'instant pas eu d'événement alarmant cette année, donc nous sommes encore en sécurité. »"
        },
        {
          "character": "naevys",
          "text": "« Il est déjà tard, je te propose de finir ta journée ici ! »",
          "choices": [
            {
              "text": "« Déjà ??? »",
              "next": "naevys-bonne-nuit"
            },
            {
              "text": "« Oh ouiiiii, merci beaucoup ! »",
              "next": "naevys-bonne-nuit"
            }
          ]
        }
      ]
    },
    "naevys-bonne-nuit": {
      "lines": [
        {
          "character": "naevys",
          "text": "« Haha, je sens qu'on va bien s'amuser avec toi ! Ne t'en fais pas, demain je te mettrai à contribution. Repose-toi bien ce soir, la journée s'annonce intense demain. »",
          "choices": [
            {
              "text": "Suite",
              "goto": "inter-scene-2-3"
            }
          ]
        }
      ]
    },
    "naevys-ingredients": {
      "lines": [
        {
          "character": "naevys",
          "text": "« Alors, tu as rassemblé tous les éléments ? »",
          "choices": [
            {
              "text": "« Oui, j'ai tout, voilà ! »",
              "next": "naevys-rituel",
              "if": [
                "glycine-prise",
                "terre-prise",
                "amethyste-prise",
                "plume-prise",
                "rose-prise",
                "lavande-prise"
              ]
            },
            {
              "text": "« Non, pas encore… »",
              "next": "naevys-compte-sur-toi"
            }
          ]
        }
      ]
    },
    "naevys-compte-sur-toi": {
      "lines": [
        {
          "character": "naevys",
          "text": "« Je compte sur toi ! »"
        }
      ]
    },
    "naevys-rituel": {
      "setFlags": ["ingredients-apportes"],
      "lines": [
        {
          "character": "naevys",
          "text": "« Parfait, on va pouvoir préparer le rituel pour ce soir. Dépose les ingrédients sur le sol arcanique, juste derrière moi. »"
        }
      ]
    },
    "sol-arcanique": {
      "setFlags": ["ingredients-deposes"],
      "lines": [
        {
          "text": "Je dépose les ingrédients sur le sol arcanique. (suite à venir)"
        }
      ]
    },
    "amethyste": {
      "setFlags": ["amethyste-prise"],
      "lines": [
        {
          "text": "Je prends quelques cristaux d'améthyste."
        }
      ]
    }
  }
}

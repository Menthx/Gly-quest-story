{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "game.json",
  "description": "Index du jeu : personnages, maps et map de départ.",
  "type": "object",
  "required": [
    "title",
    "startMap",
    "maps",
    "characters"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "description": "Titre du jeu (onglet du navigateur)."
    },
    "startMap": {
      "type": "string",
      "description": "Id de la map affichée au lancement."
    },
    "maps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "file"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Nom affiché dans le menu Carte."
          },
          "file": {
            "type": "string",
            "description": "Chemin du JSON de la map, relatif à public/."
          },
          "inMenu": {
            "type": "boolean",
            "description": "false = cachée du menu (accessible seulement par une sortie)."
          }
        }
      }
    },
    "characters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "Nom affiché. {pseudo} = pseudo du joueur."
          },
          "portrait": {
            "type": "string",
            "description": "Image du personnage, relative à public/. Absent = pas de portrait."
          },
          "color": {
            "type": "string",
            "description": "Couleur CSS du nom dans la boîte de dialogue."
          },
          "portraitFull": {
            "type": "boolean",
            "description": "true = portrait plein écran (personnage devant un décor, image 16/9) qui couvre la scène."
          }
        }
      }
    },
    "titleBackground": {
      "type": "string",
      "description": "Image de fond de l'écran titre (saisie du pseudo), relative à public/."
    },
    "quests": {
      "type": "array",
      "description": "Quêtes du cadre « Quête en cours », visibles tant que leur condition est remplie.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "objectives"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "if": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Flags tous requis pour afficher la quête."
          },
          "ifNot": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "La quête disparaît dès qu'un de ces flags est posé."
          },
          "objectives": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string"
                },
                "done": {
                  "type": "string",
                  "description": "Flag qui coche l'objectif."
                },
                "count": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  },
                  "description": "Compteur « texte X/N » : flags comptés, objectif coché quand tous sont posés."
                },
                "if": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "L'objectif n'apparaît que si tous ces flags sont posés."
                },
                "ifNot": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "L'objectif disparaît dès qu'un de ces flags est posé."
                }
              },
              "anyOf": [
                {
                  "required": [
                    "done"
                  ]
                },
                {
                  "required": [
                    "count"
                  ]
                }
              ]
            }
          }
        }
      }
    }
  }
}

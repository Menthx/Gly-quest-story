      "shape": {
        "type": "rect",
        "x": 43,
        "y": 84,
        "width": 14,
        "height": 11
      },
      "action": {
        "type": "goto",
        "map": "bibliotheque"
      }
    }
  ],
  "dialogues": {
    "jardiniere": {
      "lines": [
        {
          "text": "« L'endroit parfait pour faire pousser des herbes magiques. »"
        }
      ]
    },
    "lavande": {
      "setFlags": ["lavande-prise"],
      "lines": [
        {
          "text": "Je cueille quelques brins de lavande somnolente."
        }
      ]

  ],
  "dialogues": {
    "casiers": {
      "lines": [
        {
          "text": "Des rangées de casiers métalliques. Le tien est le 42."
        }
      ]
    },
    "lea": {
      "lines": [
        {
          "character": "lea",
          "text": "Salut ! Tu es nouveau, non ? Je ne t'ai jamais vu ici."
        },
        {
          "character": "lea",
          "text": "Je m'appelle Léa. Tu veux que je te fasse visiter ?",
          "choices": [
            {
              "text": "Avec plaisir !",
              "next": "lea-oui"
            },
            {
              "text": "Non merci, je me débrouille.",
              "next": "lea-non"
            }
          ]
        }
      ]
    },
    "lea-oui": {
      "lines": [
        {
          "character": "lea",
          "text": "Super ! Commençons par la cour, suis-moi.",
          "choices": [
            {
              "text": "(La suivre)",
              "goto": "cour"
            }
          ]
        }
      ]
    },
    "lea-non": {
      "lines": [
        {
          "character": "lea",
          "text": "Ah… d'accord. À plus tard alors !"
        }
      ]
    }
  }
}

{
  "$schema": "../../../schemas/map.schema.json",
  "id": "jardin-pergola",
  "name": "Jardin : la pergola",
  "background": "assets/backgrounds/jardin-pergola.jpg",
  "setFlags": ["pergola-vue"],
  "regions": [
    {
      "id": "pergola",
      "label": "La table de la pergola",
      "shape": {
        "type": "rect",
        "x": 56,
        "y": 50,
        "width": 10,
        "height": 14.5
      },
      "action": {
        "type": "dialogue",
        "dialogue": "pergola"
      }
    },
    {
      "id": "passage",
      "label": "Un passage",
      "ifNot": ["mission-ingredients"],
      "shape": {
        "type": "polygon",
        "points": [
          [24.9, 53.2],
          [43.8, 48.5],
          [45.3, 67.4],
          [26.4, 72.1]
        ]
      },
      "action": {
        "type": "dialogue",
        "dialogue": "passage"
      }
    },
    {
      "id": "acces-bosquet",
      "label": "Accès au bosquet",
      "if": ["mission-ingredients"],
      "ifNot": ["plume-prise"],
      "shape": {
        "type": "rect",
        "x": 25,
        "y": 43.6,
        "width": 20.4,
        "height": 27.1
      },
      "action": {
        "type": "dialogue",
        "dialogue": "bosquet"
      }
    },
    {
      "id": "vers-cours",
      "label": "Redescendre dans la cour",
      "shape": {
        "type": "rect",
        "x": 53.6,
        "y": 68.5,
        "width": 25.6,
        "height": 30.8
      },
      "action": {
        "type": "goto",
        "map": "jardin-cours"
      },
      "arrow": "down"
    }
  ],
  "dialogues": {
    "pergola": {
      "lines": [
        {
          "text": "Pour prendre une pause en plein air."
        }
      ]
    },
    "bosquet": {
      "setFlags": ["plume-prise"],
      "lines": [
        {
          "text": "Je me glisse dans le passage pour accéder au bosquet."
        },
        {
          "character": "joueur",
          "text": "Il doit bien y avoir une plume de paon s'il y a un paon dans le coin…"
        },
        {
          "text": "Je fouille quelques minutes et finis rapidement par tomber sur une plume de paon."
        },
        {
          "text": "Je sors du bosquet pour revenir dans le jardin."
        }
      ]
    },
    "passage": {
      "lines": [
        {
          "text": "Je crois voir un passage. En me faufilant, je pourrais sûrement atteindre le bosquet juste derrière le jardin… Je ferais mieux de ne pas y aller pour l'instant."
        }
      ]
    }
  }
}

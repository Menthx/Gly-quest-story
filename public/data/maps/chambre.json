{
  "$schema": "../../../schemas/map.schema.json",
  "id": "chambre",
  "name": "La chambre",
  "background": "assets/backgrounds/chambre.svg",
  "onEnter": "reveil",
  "regions": [
    {
      "id": "lit",
      "label": "Le lit",
      "shape": {
        "type": "rect",
        "x": 8,
        "y": 30,
        "width": 35,
        "height": 40
      },
      "action": {
        "type": "dialogue",
        "dialogue": "lit"
      }
    },
    {
      "id": "fenetre",
      "label": "La fenêtre",
      "shape": {
        "type": "rect",
        "x": 52,
        "y": 15,
        "width": 20,
        "height": 28
      },
      "action": {
        "type": "dialogue",
        "dialogue": "fenetre"
      }
    },
    {
      "id": "bureau",
      "label": "Le bureau",
      "shape": {
        "type": "rect",
        "x": 55,
        "y": 52,
        "width": 22,
        "height": 30
      },
      "action": {
        "type": "dialogue",
        "dialogue": "bureau"
      }
    },
    {
      "id": "vers-couloir",
      "label": "Aller au couloir",
      "shape": {
        "type": "rect",
        "x": 92,
        "y": 20,
        "width": 8,
        "height": 70
      },
      "action": {
        "type": "goto",
        "map": "couloir"
      },
      "arrow": "right"
    }
  ],
  "dialogues": {
    "reveil": {
      "lines": [
        {
          "text": "Le réveil sonne. Premier jour dans ce nouveau lycée…"
        },
        {
          "text": "Clique sur les éléments de la pièce pour interagir, ou sur la flèche à droite pour sortir."
        }
      ]
    },
    "lit": {
      "lines": [
        {
          "text": "Il est encore tout chaud. Cinq minutes de plus ?"
        },
        {
          "text": "Non. Pas aujourd'hui."
        }
      ]
    },
    "fenetre": {
      "lines": [
        {
          "text": "Il fait beau dehors. Parfait pour une rentrée."
        }
      ]
    },
    "bureau": {
      "lines": [
        {
          "text": "Ton sac est prêt. Il ne manque plus que toi."
        }
      ]
    }
  }
}

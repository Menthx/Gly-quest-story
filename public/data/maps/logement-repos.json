      "shape": {
        "type": "rect",
        "x": 45,
        "y": 38.5,
        "width": 17.8,
        "height": 17.7
      },
      "action": {
        "type": "dialogue",
        "dialogue": "banquette"
      }
    },
    {
      "id": "feu",
      "label": "S'installer au coin du feu et écouter de la musique ?",

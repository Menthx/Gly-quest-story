{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Map",
  "description": "Une map = un background, ses zones cliquables et ses dialogues (ou un interlude, ou les crédits). Coordonnées en % de l'image (0 à 100). {pseudo} dans un texte = pseudo du joueur.",
  "type": "object",
  "required": [
    "id",
    "name"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "background": {
      "$ref": "#/$defs/media",
      "description": "Image ou vidéo de fond, relative à public/. Absent = fond uni (backgroundColor)."
    },
    "regions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/region"
      }
    },
    "dialogues": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/dialogue"
      }
    },
    "backgroundColor": {
      "type": "string",
      "description": "Couleur CSS du fond quand il n'y a pas d'image."
    },
    "triggers": {
      "type": "array",
      "description": "Dialogues lancés automatiquement, une fois chacun, dès que leur condition est remplie (à l'arrivée et après chaque dialogue).",
      "items": {
        "type": "object",
        "required": [
          "dialogue"
        ],
        "additionalProperties": false,
        "properties": {
          "dialogue": {
            "type": "string"
          },
          "if": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ifNot": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ifMore": {
            "type": "object",
            "required": [
              "flags",
              "than"
            ],
            "additionalProperties": false,
            "description": "Vraie s'il y a plus de flags posés dans flags que dans than (ex. majorité de réponses A).",
            "properties": {
              "flags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "than": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "interlude": {
      "type": "object",
      "description": "Écran de transition : texte centré sur fond uni.",
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "next": {
          "type": "string",
          "description": "Map suivante (bouton Suite). Absent = pas de bouton."
        }
      }
    },
    "setFlags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Flags posés à l'arrivée sur la map (ex. lieu visité)."
    },
    "credits": {
      "type": "object",
      "description": "Écran de fin : crédits sur le fond flouté (background), puis les statistiques du joueur comparées aux autres joueurs (envoyées au script Google de statsUrl).",
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "description": "Texte des crédits. Le premier paragraphe est affiché en titre ; une ligne vide sépare deux paragraphes."
        },
        "thanks": {
          "type": "string",
          "description": "Titre au-dessus des statistiques (ex. « Merci d'avoir joué ! »)."
        },
        "stats": {
          "type": "array",
          "description": "Statistiques : le joueur reçoit une réponse par statistique.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "answers"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "description": "Nom de la statistique (colonne de l'onglet « Fins » du Google Sheet)."
              },
              "answers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "text"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "flags": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Le joueur a cette réponse s'il en a posé plus de flags que pour les autres réponses (égalité : la première). Absent = réponse par défaut, quand aucun flag des autres réponses n'est posé."
                    },
                    "text": {
                      "type": "string",
                      "description": "Phrase affichée. {pct} = % des joueurs ayant cette réponse, {pct:<id>} = % ayant la réponse <id>."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "region": {
      "type": "object",
      "required": [
        "id",
        "shape",
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "description": "Texte affiché au survol."
        },
        "shape": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "type",
                "x",
                "y",
                "width",
                "height"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "rect"
                },
                "x": {
                  "$ref": "#/$defs/percent"
                },
                "y": {
                  "$ref": "#/$defs/percent"
                },
                "width": {
                  "$ref": "#/$defs/percent"
                },
                "height": {
                  "$ref": "#/$defs/percent"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "points"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "polygon"
                },
                "points": {
                  "type": "array",
                  "minItems": 3,
                  "items": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "$ref": "#/$defs/percent"
                      },
                      {
                        "$ref": "#/$defs/percent"
                      }
                    ],
                    "minItems": 2,
                    "maxItems": 2
                  }
                }
              }
            }
          ]
        },
        "action": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "type",
                "dialogue"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "dialogue"
                },
                "dialogue": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "map"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "goto"
                },
                "map": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "arrow": {
          "enum": [
            "left",
            "right",
            "up",
            "down"
          ],
          "description": "Flèche affichée dans la zone (sorties)."
        },
        "if": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "La zone n'apparaît que si tous ces flags sont posés."
        },
        "ifNot": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "La zone disparaît dès qu'un de ces flags est posé."
        },
        "ifMore": {
          "type": "object",
          "required": [
            "flags",
            "than"
          ],
          "additionalProperties": false,
          "description": "Vraie s'il y a plus de flags posés dans flags que dans than (ex. majorité de réponses A).",
          "properties": {
            "flags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "than": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "button": {
          "type": "string",
          "description": "Bouton toujours visible avec ce texte au centre de la zone (ex. Porte)."
        }
      }
    },
    "dialogue": {
      "type": "object",
      "required": [
        "lines"
      ],
      "additionalProperties": false,
      "properties": {
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "character": {
                "type": "string",
                "description": "Id du personnage (game.json). Absent = narrateur."
              },
              "name": {
                "type": "string",
                "description": "Nom affiché à la place de celui du personnage (ex. \"???\" tant qu'il ne s'est pas présenté)."
              },
              "text": {
                "type": "string"
              },
              "hidePortraits": {
                "type": "boolean",
                "description": "Retire les portraits affichés jusque-là et n'affiche pas celui du personnage de cette réplique. Ils reviennent à la réplique suivante de leur personnage."
              },
              "media": {
                "$ref": "#/$defs/media",
                "description": "Image ou vidéo plein écran sur la scène à partir de cette réplique, jusqu'à la fin du dialogue (prioritaire sur les portraits plein écran). \"\" la retire."
              },
              "waitMedia": {
                "type": "boolean",
                "description": "La réplique ne peut pas être passée : elle avance seule à la fin de la vidéo de son media (une liste dont la vidéo n'est pas la dernière, la dernière tournant en boucle)."
              },
              "choices": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "text"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "next": {
                      "type": "string",
                      "description": "Id du dialogue suivant. Absent = ferme le dialogue."
                    },
                    "goto": {
                      "type": "string",
                      "description": "Id de la map où aller après ce choix."
                    },
                    "setFlags": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Flags posés quand on choisit cette option."
                    },
                    "if": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Le choix n'est proposé que si tous ces flags sont posés."
                    },
                    "ifNot": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Le choix disparaît dès qu'un de ces flags est posé."
                    },
                    "ifMore": {
                      "type": "object",
                      "required": [
                        "flags",
                        "than"
                      ],
                      "additionalProperties": false,
                      "description": "Vraie s'il y a plus de flags posés dans flags que dans than (ex. majorité de réponses A).",
                      "properties": {
                        "flags": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "than": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "setFlags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Flags posés à l'ouverture du dialogue."
        },
        "next": {
          "description": "Dialogue enchaîné après la dernière réplique (même map). Absent = ferme le dialogue. Une liste de branches prend le premier dialogue dont la condition est remplie.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "dialogue"
                ],
                "additionalProperties": false,
                "properties": {
                  "dialogue": {
                    "type": "string",
                    "description": "Id du dialogue (même map)."
                  },
                  "if": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Branche retenue seulement si tous ces flags sont posés."
                  },
                  "ifNot": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Branche écartée dès qu'un de ces flags est posé."
                  },
                  "ifMore": {
                    "type": "object",
                    "required": [
                      "flags",
                      "than"
                    ],
                    "additionalProperties": false,
                    "description": "Vraie s'il y a plus de flags posés dans flags que dans than (ex. majorité de réponses A).",
                    "properties": {
                      "flags": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "than": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "media": {
      "description": "Image ou vidéo (.mp4, .webm…), relative à public/. Une vidéo tourne en boucle. Une liste de vidéos est jouée à la suite, la dernière en boucle.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      ]
    }
  }
}

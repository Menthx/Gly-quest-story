{
  "$schema": "../../../schemas/map.schema.json",
  "id": "couloir",
  "name": "Le couloir",
  "background": "assets/backgrounds/couloir.svg",
  "regions": [
    {
      "id": "casiers",
      "label": "Les casiers",
      "shape": {
        "type": "rect",

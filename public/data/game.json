{
  "$schema": "../../schemas/game.schema.json",
  "title": "Glyglyland et l'énergie ancienne",
  "titleBackground": "assets/backgrounds/train-exterieur.jpg",
  "startMap": "train-interieur",
  "statsUrl": "https://script.google.com/macros/s/AKfycbypc6AvplU80Ypi7QCPevlkK6uSHP7Yi3ZUgiAdx0sbtZiEMXfhoyjMOvJABRokr_dH/exec",
  "characters": {
    "joueur": {
      "name": "{pseudo}",
      "color": "#f2d48a"
    },
    "annonce": {
      "name": "Annonce",
      "color": "#9fd3ff"
    },
    "naevys": {
      "name": "Naevys",
      "portrait": "assets/characters/naevys.jpg",
      "portraitFull": true,
      "color": "#a8e6cf"
    }
  },
  "quests": [
    {
      "id": "avant-arrivee",
      "title": "Avant l'arrivée",
      "if": ["depart"],
      "ifNot": ["arrivee"],
      "objectives": [
        {
          "text": "Fouiller la valise",
          "done": "lettre-lue"
        },
        {
          "text": "Explorer l'extérieur du train",
          "done": "licorne-vue"
        }
      ]
    },
    {
      "id": "visite-bibliotheque",
      "title": "Visite la bibliothèque",
      "if": ["mission-visite"],
      "ifNot": ["visite-terminee"],
      "objectives": [
        {
          "text": "Bibliothèque",
          "count": ["foyer-vu", "bureau-vu", "coin-douillet-vu"]
        },
        {
          "text": "Jardin",
          "count": ["serre-vue", "cours-vu", "pergola-vue"]
        },
        {
          "text": "Retourne voir Naevys",
          "done": "visite-terminee",
          "if": [
            "foyer-vu",
            "bureau-vu",
            "coin-douillet-vu",
            "serre-vue",
            "cours-vu",
            "pergola-vue"
          ]
        }
      ]
    },
    {
      "id": "rejoindre-foyer",
      "title": "Le plan de Naevys",
      "if": ["rdv-foyer"],
      "ifNot": ["mission-ingredients"],
      "objectives": [
        {
          "text": "Rejoins Naevys près du foyer",
          "done": "mission-ingredients"
        }
      ]
    },
    {
      "id": "elements-rituel",
      "title": "Récupère les éléments de la liste",
      "if": ["mission-ingredients"],
      "ifNot": ["ingredients-apportes"],
      "objectives": [
        {
          "text": "Essence de glycine concentrée",
          "done": "glycine-prise"
        },
        {
          "text": "Terre de Glyglyland",
          "done": "terre-prise"
        },
        {
          "text": "Cristaux d'améthyste",
          "done": "amethyste-prise"
        },
        {
          "text": "Plume de paon",
          "done": "plume-prise"
        },
        {
          "text": "Rose",
          "done": "rose-prise"
        },
        {
          "text": "Lavande somnolente",
          "done": "lavande-prise"
        },
        {
          "text": "Retourne voir Naevys",
          "done": "ingredients-apportes",
          "if": [
            "glycine-prise",
            "terre-prise",
            "amethyste-prise",
            "plume-prise",
            "rose-prise",
            "lavande-prise"
          ]
        }
      ]
    },
    {
      "id": "mise-en-place-rituel",
      "title": "Mise en place du rituel",
      "if": ["ingredients-apportes"],
      "ifNot": ["ingredients-deposes"],
      "objectives": [
        {
          "text": "Dépose les ingrédients sur le sol arcanique",
          "done": "ingredients-deposes"
        }
      ]
    }
  ],

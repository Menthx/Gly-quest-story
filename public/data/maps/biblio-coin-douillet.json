      "action": {
        "type": "dialogue",
        "dialogue": "bocal"
      }
    },
    {
      "id": "glycine",
      "label": "Essence de glycine concentrée",
      "if": ["mission-ingredients"],
      "ifNot": ["glycine-prise"],
      "shape": {
        "type": "rect",
        "x": 49.5,
        "y": 47.5,
        "width": 6,
        "height": 11

{
  "$schema": "../../../schemas/map.schema.json",
  "id": "jardin-cours",
  "name": "Jardin : la cour",
  "background": "assets/backgrounds/jardin-cours.jpg",
  "setFlags": ["cours-vu"],
  "triggers": [
    {
      "dialogue": "paon",
      "if": ["pergola-vue"]
    }
  ],
  "regions": [
    {
      "id": "citrouilles",
      "label": "Les citrouilles du jardin",
      "shape": {
        "type": "rect",
        "x": 57.5,
        "y": 30.1,
        "width": 22.5,
        "height": 23
      },
      "action": {
        "type": "dialogue",
        "dialogue": "citrouilles"
      }
    },
    {
      "id": "champignon",
      "label": "Le champignon du jardin",
      "shape": {
        "type": "rect",
        "x": 33.1,
        "y": 69.2,
        "width": 38.2,
        "height": 30.8
      },
      "action": {
        "type": "dialogue",
        "dialogue": "champignon"
      }
    },
    {
      "id": "terre",
      "label": "De la terre",
      "if": ["mission-ingredients", "bocal-pris"],
      "ifNot": ["terre-prise"],
      "shape": {
        "type": "rect",
        "x": 53.8,
        "y": 77.7,
        "width": 17.7,
        "height": 16.3
      },
      "action": {
        "type": "dialogue",
        "dialogue": "terre"
      }
    },
    {
      "id": "terre-sans-bocal",
      "label": "De la terre",
      "if": ["mission-ingredients"],
      "ifNot": ["bocal-pris"],
      "shape": {
        "type": "rect",
        "x": 53.8,
        "y": 77.7,
        "width": 17.7,
        "height": 16.3
      },
      "action": {
        "type": "dialogue",
        "dialogue": "terre-sans-bocal"
      }
    },
    {
      "id": "vers-pergola",
      "label": "Monter à la pergola",
      "shape": {
        "type": "rect",
        "x": 38.1,
        "y": 34.4,
        "width": 8.7,
        "height": 14.4
      },
      "action": {
        "type": "goto",
        "map": "jardin-pergola"
      },
      "arrow": "up"
    },
    {
      "id": "vers-serre",
      "label": "Retourner à la serre",
      "shape": {
        "type": "polygon",
        "points": [
          [86.9, 21.6],
          [100, 30.6],
          [100, 95.2],
          [79.3, 86.1]
        ]
      },
      "action": {
        "type": "goto",
        "map": "jardin-serre"
      },
      "arrow": "right"
    }
  ],
  "dialogues": {
    "citrouilles": {
      "lines": [
        {
          "text": "Les citrouilles du jardin."
        }
      ]
    },
    "champignon": {
      "lines": [
        {
          "text": "Les champignons du jardin."
        }
      ]
    },
    "paon": {
      "lines": [
        {
          "text": "« Tiens ? J'ai entendu un paon dans le bois ! Mince, je crois que je lui ai fait peur… »"
        }
      ]
    },
    "terre": {
      "setFlags": ["terre-prise"],
      "lines": [
        {
          "character": "joueur",
          "text": "« Je prends un peu de terre dans mon bocal. »"
        }
      ]
    },
    "terre-sans-bocal": {
      "lines": [
        {
          "character": "joueur",
          "text": "« Il me faudrait un contenant pour transporter la terre. »"
        }
      ]
    }
  }
}

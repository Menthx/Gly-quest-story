        "y": 20,
        "width": 14,
        "height": 50
      },
      "action": {
        "type": "dialogue",
        "dialogue": "casiers"
      }
    },
    {
      "id": "lea",
      "label": "Léa",
      "shape": {
        "type": "polygon",
        "points": [
          [42, 85],
          [44, 40],
          [47, 31],
          [49, 25],
          [51, 31],
          [54, 40],
          [56, 85]
        ]
      },
      "action": {
        "type": "dialogue",
        "dialogue": "lea"
      }
    },
    {
      "id": "porte-cafe",
      "label": "Entrer au café",
      "shape": {
        "type": "rect",
        "x": 60,
        "y": 18,
        "width": 14,
        "height": 52
      },
      "action": {
        "type": "goto",
        "map": "cafe"
      }
    },
    {
      "id": "vers-chambre",
      "label": "Retour à la chambre",
      "shape": {
        "type": "rect",
        "x": 0,
        "y": 20,
        "width": 8,
        "height": 70
      },
      "action": {
        "type": "goto",
        "map": "chambre"
      },
      "arrow": "left"
    },
    {
      "id": "vers-cour",
      "label": "Aller dans la cour",
      "shape": {
        "type": "rect",
        "x": 92,
        "y": 20,
        "width": 8,
        "height": 70
      },
      "action": {
        "type": "goto",
        "map": "cour"
      },
      "arrow": "right"

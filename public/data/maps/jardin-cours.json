{
  "$schema": "../../../schemas/map.schema.json",
  "id": "jardin-cours",
  "name": "Jardin : la cour",
  "background": "assets/backgrounds/jardin-cours.jpg",
  "setFlags": ["cours-vu"],
  "triggers": [
    {
      "dialogue": "paon",
      "if": ["pergola-vue"]
    }
  ],
  "regions": [
    {
      "id": "citrouilles",
      "label": "Les citrouilles du jardin",
      "shape": {
        "type": "rect",
        "x": 63,
        "y": 35,
        "width": 17,
        "height": 15
      },
      "action": {
        "type": "dialogue",
        "dialogue": "citrouilles"
      }
    },
    {
      "id": "champignon",
      "label": "Le champignon du jardin",
      "shape": {
        "type": "rect",
        "x": 33,
        "y": 72,
        "width": 36,
        "height": 27
      },
      "action": {
        "type": "dialogue",
        "dialogue": "champignon"
      }
    },
    {
      "id": "terre",
      "label": "De la terre",
      "if": ["mission-ingredients", "bocal-pris"],
      "ifNot": ["terre-prise"],
      "shape": {
        "type": "rect",
        "x": 52,
        "y": 82,
        "width": 14,
        "height": 10
      },
      "action": {
        "type": "dialogue",
        "dialogue": "terre"
      }
    },
    {
      "id": "terre-sans-bocal",
      "label": "De la terre",
      "if": ["mission-ingredients"],
      "ifNot": ["bocal-pris"],
      "shape": {
        "type": "rect",
        "x": 52,
        "y": 82,
        "width": 14,
        "height": 10
      },
      "action": {
        "type": "dialogue",
        "dialogue": "terre-sans-bocal"
      }
    },
    {
      "id": "roses",
      "label": "Le parterre de roses",
      "if": ["mission-ingredients"],
      "ifNot": ["rose-prise"],
      "shape": {
        "type": "rect",
        "x": 51,
        "y": 36,
        "width": 11,
        "height": 9
      },
      "action": {
        "type": "dialogue",
        "dialogue": "roses"
      }
    },
    {
      "id": "vers-pergola",
      "label": "Monter à la pergola",
      "shape": {
        "type": "rect",
        "x": 38.5,
        "y": 36,
        "width": 8,
        "height": 11
      },
      "action": {
        "type": "goto",
        "map": "jardin-pergola"
      },
      "arrow": "up"
    },
    {
      "id": "vers-serre",
      "label": "Retourner à la serre",
      "shape": {
        "type": "rect",
        "x": 90,
        "y": 30,
        "width": 10,
        "height": 50
      },
      "action": {
        "type": "goto",
        "map": "jardin-serre"
      },
      "arrow": "right"
    }
  ],
  "dialogues": {
    "citrouilles": {
      "lines": [
        {
          "text": "Les citrouilles du jardin. (texte à venir)"
        }
      ]
    },
    "champignon": {
      "lines": [
        {
          "text": "Le champignon du jardin. (texte à venir)"
        }
      ]
    },
    "paon": {
      "lines": [
        {
          "text": "« Tiens ? J'ai entendu un paon dans le bois ! Mince, je crois que je lui ai fait peur… »"
        },
        {
          "text": "Je crois voir un passage. En me faufilant, je pourrais sûrement atteindre le bosquet juste derrière le jardin… Je ferais mieux de ne pas y aller pour l'instant."
        }
      ]
    },
    "terre": {
      "setFlags": ["terre-prise"],
      "lines": [
        {
          "character": "joueur",
          "text": "« Je prends un peu de terre dans mon bocal. »"
        }
      ]
    },
    "terre-sans-bocal": {
      "lines": [
        {
          "character": "joueur",
          "text": "« Il me faudrait un contenant pour transporter la terre. »"
        }
      ]
    },
    "roses": {
      "setFlags": ["rose-prise"],
      "lines": [
        {
          "text": "Je cueille une rose du parterre."
        }
      ]
    }
  }
}

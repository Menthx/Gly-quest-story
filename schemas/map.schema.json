{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Map",
  "description": "Une map = un background, ses zones cliquables et ses dialogues (ou un interlude). Coordonnées en % de l'image (0 à 100). {pseudo} dans un texte = pseudo du joueur.",
  "type": "object",
  "required": [
    "id",
    "name"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "background": {
      "type": "string",
      "description": "Image de fond, relative à public/. Absent = fond uni (backgroundColor)."
    },
    "regions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/region"
      }
    },
    "dialogues": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/dialogue"
      }
    },
    "backgroundColor": {
      "type": "string",
      "description": "Couleur CSS du fond quand il n'y a pas d'image."
    },
    "triggers": {
      "type": "array",
      "description": "Dialogues lancés automatiquement, une fois chacun, dès que leur condition est remplie (à l'arrivée et après chaque dialogue).",
      "items": {
        "type": "object",
        "required": [
          "dialogue"
        ],
        "additionalProperties": false,
        "properties": {
          "dialogue": {
            "type": "string"
          },
          "if": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ifNot": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "interlude": {
      "type": "object",
      "description": "Écran de transition : texte centré sur fond uni.",
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "next": {
          "type": "string",
          "description": "Map suivante (bouton Suite). Absent = pas de bouton."
        }
      }
    },
    "setFlags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Flags posés à l'arrivée sur la map (ex. lieu visité)."
    }
  },
  "$defs": {
    "percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "region": {
      "type": "object",
      "required": [
        "id",
        "shape",
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "description": "Texte affiché au survol."
        },
        "shape": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "type",
                "x",
                "y",
                "width",
                "height"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "rect"
                },
                "x": {
                  "$ref": "#/$defs/percent"
                },
                "y": {
                  "$ref": "#/$defs/percent"
                },
                "width": {
                  "$ref": "#/$defs/percent"
                },
                "height": {
                  "$ref": "#/$defs/percent"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "points"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "polygon"
                },
                "points": {
                  "type": "array",
                  "minItems": 3,
                  "items": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "$ref": "#/$defs/percent"
                      },
                      {
                        "$ref": "#/$defs/percent"
                      }
                    ],
                    "minItems": 2,
                    "maxItems": 2
                  }
                }
              }
            }
          ]
        },
        "action": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "type",
                "dialogue"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "dialogue"
                },
                "dialogue": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "map"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "goto"
                },
                "map": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "arrow": {
          "enum": [
            "left",
            "right",
            "up",
            "down"
          ],
          "description": "Flèche affichée dans la zone (sorties)."
        },
        "if": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "La zone n'apparaît que si tous ces flags sont posés."
        },
        "ifNot": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "La zone disparaît dès qu'un de ces flags est posé."
        },
        "button": {
          "type": "string",
          "description": "Bouton toujours visible avec ce texte au centre de la zone (ex. Porte)."
        }
      }
    },
    "dialogue": {
      "type": "object",
      "required": [
        "lines"
      ],
      "additionalProperties": false,
      "properties": {
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "character": {
                "type": "string",
                "description": "Id du personnage (game.json). Absent = narrateur."
              },
              "text": {
                "type": "string"
              },
              "choices": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "text"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "next": {
                      "type": "string",
                      "description": "Id du dialogue suivant. Absent = ferme le dialogue."
                    },
                    "goto": {
                      "type": "string",
                      "description": "Id de la map où aller après ce choix."
                    },
                    "setFlags": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Flags posés quand on choisit cette option."
                    },
                    "if": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Le choix n'est proposé que si tous ces flags sont posés."
                    },
                    "ifNot": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Le choix disparaît dès qu'un de ces flags est posé."
                    }
                  }
                }
              }
            }
          }
        },
        "setFlags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Flags posés à l'ouverture du dialogue."
        },
        "next": {
          "type": "string",
          "description": "Id du dialogue enchaîné après la dernière réplique (même map). Absent = ferme le dialogue."
        }
      }
    }
  }
}
